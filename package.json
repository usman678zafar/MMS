{
  "name": "mms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin:sync": "node --env-file=.env direct-migrate.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.mjs",
    "db:backup:mongo": "node --env-file=.env scripts/backup-mongodb.js",
    "db:backup:verify": "node scripts/verify-mongodb-backup.js",
    "db:import:mongo": "node --env-file=.env scripts/migrate-mongodb-backup-to-postgres.mjs",
    "db:repair": "node --env-file=.env scripts/repair-database.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "next": "16.3.0-preview.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0-preview.10",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "uuid": "11.1.1"
  }
}
